#!/usr/bin/env bash
# tomini — rsync files/dirs to the mini (default: Claude Inbox)
#
#   tomini <path>...          -> ~/Claude/Inbox
#   tomini inbox <path>...    -> ~/Claude/Inbox (same as default)
#   tomini media <path>...    -> /Volumes/LaCie/Inbox
set -euo pipefail

# Remote host lives outside the repo: set TOMINI_HOST (user@host) in the
# environment or in ~/.config/tomini.
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/tomini"
if [ -z "${TOMINI_HOST:-}" ] && [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi
if [ -z "${TOMINI_HOST:-}" ]; then
  echo "tomini: TOMINI_HOST not set (put TOMINI_HOST=user@host in $CONFIG_FILE)" >&2
  exit 1
fi

DEST_HOST="$TOMINI_HOST"
DEST_PATH="/Users/nabeel/Claude/Inbox/"

# Optional first arg picks a named destination. To push a local file that's
# literally named "inbox" or "media", write ./inbox or ./media.
case "${1:-}" in
  inbox)
    shift
    ;;
  media)
    DEST_PATH="/Volumes/LaCie/Inbox/"
    shift
    ;;
esac

if [ "$#" -eq 0 ]; then
  echo "usage: tomini [inbox|media] <file_or_dir> [more...]" >&2
  exit 1
fi

for src in "$@"; do
  if [ ! -e "$src" ]; then
    echo "skipping, doesn't exist: $src" >&2
    continue
  fi

  # strip any trailing slash so foo and foo/ both mean "copy the dir itself"
  # (glob expansion, e.g. foo/*, already gives you individual entries — leave those alone)
  src="${src%/}"

  rsync -avz --progress \
    --no-perms --no-owner --no-group \
    -e ssh \
    "$src" "${DEST_HOST}:${DEST_PATH}"
done
